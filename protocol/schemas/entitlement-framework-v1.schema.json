{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelbridge.dev/protocol/schemas/entitlement-framework-v1.schema.json",
  "title": "KernelBridge Entitlement Framework v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "catalog_revision",
    "source_revision",
    "grants"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "enum": [
        "direct",
        "product_platform"
      ]
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "grants": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/grant"
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "reset",
        "time_zone"
      ],
      "properties": {
        "unit": {
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ]
        },
        "reset": {
          "const": "calendar"
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "grant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "enabled"
          ],
          "properties": {
            "type": {
              "const": "capability"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "state",
            "unit",
            "scope"
          ],
          "properties": {
            "type": {
              "const": "limit"
            },
            "state": {
              "const": "finite"
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "scope": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "period": {
              "$ref": "#/$defs/period"
            }
          },
          "allOf": [
            {
              "required": [
                "value"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "state",
            "unit",
            "scope"
          ],
          "properties": {
            "type": {
              "const": "limit"
            },
            "state": {
              "const": "unlimited"
            },
            "unit": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "scope": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            },
            "period": {
              "$ref": "#/$defs/period"
            }
          },
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    }
  }
}
