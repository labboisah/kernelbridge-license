{
    "name": "kernelbridge/licensing-client-laravel",
    "version": "1.2.3",
    "description": "Reusable Laravel client for KernelBridge licensing, subscriptions and entitlements.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "KernelBridge\\LicensingClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": { "KernelBridge\\LicensingClient\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["KernelBridge\\LicensingClient\\KernelBridgeLicensingServiceProvider"]
        }
    }
}
